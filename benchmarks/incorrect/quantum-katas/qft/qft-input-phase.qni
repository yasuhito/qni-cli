qni add Z --qubit 0 --step 0
qni add H --qubit 0 --step 1
qni add P --qubit 0 --angle pi/2 --control 1 --step 2
qni add P --qubit 0 --angle pi/4 --control 2 --step 3
qni add H --qubit 1 --step 4
qni add P --qubit 1 --angle pi/2 --control 2 --step 5
qni add H --qubit 2 --step 6
qni add SWAP --qubit 0,2 --step 7
