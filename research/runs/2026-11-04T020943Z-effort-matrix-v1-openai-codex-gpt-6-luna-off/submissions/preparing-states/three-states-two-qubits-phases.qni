qni add Ry --angle π/2 --qubit 0 --step 0
qni add Ry --angle π/2 --control 0 --qubit 1 --step 1
qni add X --qubit 0 --step 2
qni add Ry --angle -π/2 --qubit 0 --step 3
qni add P --angle 2π/3 --qubit 1 --step 4
qni add X --qubit 0 --step 5
qni add P --angle 4π/3 --qubit 0 --step 6
qni add X --qubit 0 --step 7
qni add P --angle -4π/3 --qubit 0 --step 8