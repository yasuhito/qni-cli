diff --git a/tests/unit-setting-sources.mjs b/tests/unit-setting-sources.mjs
new file mode 100644
index 0000000..62fefb7
--- /dev/null
+++ b/tests/unit-setting-sources.mjs
@@ -0,0 +1,98 @@
+/**
+ * provider.settingSources lets a caller run the provider's Claude Code child in
+ * SDK isolation mode (`[]`), so the user's ~/.claude settings, hooks, plugins and
+ * language do not reach a request. Omitted keeps Claude Code's default (all sources).
+ */
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { CONFIG_DIR_NAME } from "@earendil-works/pi-coding-agent";
+import { loadConfig } from "../src/config.js";
+import activate, { __test } from "../src/index.js";
+
+const ACTIVE_STREAM_SIMPLE_KEY = Symbol.for("claude-bridge:activeStreamSimple");
+
+function projectWithConfig(config) {
+	const cwd = mkdtempSync(join(tmpdir(), "claude-bridge-setting-sources-"));
+	if (config !== undefined) {
+		mkdirSync(join(cwd, CONFIG_DIR_NAME), { recursive: true });
+		writeFileSync(join(cwd, CONFIG_DIR_NAME, "claude-bridge.json"), JSON.stringify(config));
+	}
+	return cwd;
+}
+
+async function providerQueryOptions(t, config) {
+	const cwd = projectWithConfig(config);
+	const previousCwd = process.cwd();
+	process.chdir(cwd);
+	t.after(() => {
+		process.chdir(previousCwd);
+		rmSync(cwd, { recursive: true, force: true });
+	});
+	globalThis[ACTIVE_STREAM_SIMPLE_KEY] = undefined;
+	let providerConfig;
+	activate({ on: () => {}, registerProvider: (_name, value) => { providerConfig = value; }, registerTool: () => {} });
+	t.after(() => { globalThis[ACTIVE_STREAM_SIMPLE_KEY] = undefined; });
+
+	let options;
+	__test.setQuery(({ options: queryOptions }) => {
+		options = queryOptions;
+		const gen = (async function* () {
+			yield { type: "system", subtype: "init", session_id: "cc-setting-sources" };
+			yield { type: "result", subtype: "success", is_error: false, result: "ok" };
+		})();
+		gen.interrupt = async () => {};
+		gen.close = () => {};
+		return gen;
+	});
+	t.after(() => __test.setQuery(null));
+	__test.resetSharedSession();
+
+	await providerConfig.streamSimple(providerConfig.models[0], { messages: [{ role: "user", content: "hi", timestamp: 0 }], tools: [] }, {}).result();
+	return options;
+}
+
+describe("provider.settingSources config", () => {
+	it("keeps an empty array from the project config", () => {
+		const cwd = projectWithConfig({ provider: { settingSources: [] } });
+		try {
+			assert.deepEqual(loadConfig(cwd).provider.settingSources, []);
+		} finally {
+			rmSync(cwd, { recursive: true, force: true });
+		}
+	});
+
+	it("keeps known sources", () => {
+		const cwd = projectWithConfig({ provider: { settingSources: ["project", "local"] } });
+		try {
+			assert.deepEqual(loadConfig(cwd).provider.settingSources, ["project", "local"]);
+		} finally {
+			rmSync(cwd, { recursive: true, force: true });
+		}
+	});
+
+	for (const invalid of ["user", ["global"], [1], ["user", "user"], null, {}]) {
+		it(`rejects ${JSON.stringify(invalid)}`, () => {
+			const cwd = projectWithConfig({ provider: { settingSources: invalid } });
+			try {
+				assert.throws(() => loadConfig(cwd), /provider\.settingSources/);
+			} finally {
+				rmSync(cwd, { recursive: true, force: true });
+			}
+		});
+	}
+});
+
+describe("provider query settingSources", () => {
+	it("omits settingSources by default so Claude Code loads its default sources", async (t) => {
+		const options = await providerQueryOptions(t, undefined);
+		assert.equal(Object.hasOwn(options, "settingSources"), false);
+	});
+
+	it("forwards an empty array to the SDK", async (t) => {
+		const options = await providerQueryOptions(t, { provider: { settingSources: [] } });
+		assert.deepEqual(options.settingSources, []);
+	});
+});
