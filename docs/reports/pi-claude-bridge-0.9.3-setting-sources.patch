+const SETTING_SOURCES: readonly SettingSource[] = ["user", "project", "local"];
+
+/** Rejects a malformed provider.settingSources rather than falling back to all
+ *  sources: a caller that asked for isolation must not silently lose it. */
+export function validateSettingSources(value: unknown): SettingSource[] | undefined {
+	if (value === undefined) return undefined;
+	const valid = Array.isArray(value)
+		&& value.every((source) => SETTING_SOURCES.includes(source))
+		&& new Set(value).size === value.length;
+	if (!valid) {
+		throw new Error(`claude-bridge: provider.settingSources must be an array of distinct "user", "project" or "local", got ${JSON.stringify(value)}`);
+	}
+	return [...value];
+}
+
+export function settingSourcesOption(provider: Config["provider"] = {}): { settingSources?: SettingSource[] } {
+	return provider.settingSources ? { settingSources: [...provider.settingSources] } : {};
+}
